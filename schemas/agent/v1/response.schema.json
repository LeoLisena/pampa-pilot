{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pampapilot.local/schemas/agent/v1/response.schema.json",
  "title": "PampaPilot LLM Response 1.0",
  "type": "object",
  "required": ["protocol_version", "message", "proposal", "actions"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "message": {"type": "string", "maxLength": 8000},
    "proposal": {"type": ["object", "null"]},
    "actions": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "types.schema.json#/$defs/action"}
    }
  },
  "additionalProperties": false
}
