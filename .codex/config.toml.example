# Copiar como .codex/config.toml y reemplazar las rutas absolutas.
[mcp_servers.pampapilot]
command = "C:\\RUTA\\AL\\PROYECTO\\.venv-pampapilot\\Scripts\\python.exe"
args = ["-m", "pampapilot.mcp_server"]
